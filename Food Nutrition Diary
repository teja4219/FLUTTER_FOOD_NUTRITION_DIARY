          ElevatedButton(
            onPressed: () {
              final value = int.tryParse(c.text);

              if (value != null && value > 0) {
                setState(() => goal = value);
              }

              Navigator.pop(ctx);
            },
            child: const Text('Save'),
          ),
        ],
      ),
    );
  }

