  // BMI CALCULATOR
  Widget bmiCard() {
    final h = TextEditingController();
    final w = TextEditingController();

    return Card(
      color: Colors.white,
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            TextField(
              controller: h,
              keyboardType: TextInputType.number,
              decoration: const InputDecoration(labelText: 'Height (cm)'),
            ),
            TextField(
              controller: w,
              keyboardType: TextInputType.number,
              decoration: const InputDecoration(labelText: 'Weight (kg)'),
            ),
            const SizedBox(height: 12),

            ElevatedButton(
              style: ElevatedButton.styleFrom(
                backgroundColor: green,
                foregroundColor: Colors.white,
              ),
              onPressed: () {
                final height = double.tryParse(h.text);
                final weight = double.tryParse(w.text);

                if (height == null ||
                    weight == null ||
                    height <= 0 ||
                    weight <= 0) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(content: Text('Enter valid values')),
                  );
                  return;
                }

                final bmi = weight / ((height / 100) * (height / 100));

                final category = bmi < 18.5
                    ? 'Underweight'
                    : bmi < 25
                    ? 'Normal range'
                    : bmi < 30
                    ? 'Overweight'
                    : 'Obesity range';

                showDialog(
                  context: context,
                  builder: (ctx) => AlertDialog(
                    title: const Text('BMI Result'),
                    content: Text(
                      'BMI: ${bmi.toStringAsFixed(1)}\n'
                      'Category: $category\n\n'
                      'BMI is a screening measure, not a diagnosis.',
                    ),
                    actions: [
                      TextButton(
                        onPressed: () => Navigator.pop(ctx),
                        child: const Text('OK'),
                      ),
                    ],
                  ),
                );
              },
              child: const Text('Calculate BMI'),
            ),
          ],
        ),
      ),
    );
  }

  // ADD FOOD DIALOG
  void addFoodDialog() {
    Food selected = foods.first;
    String type = 'Breakfast';
    String search = '';

    final quantity = TextEditingController(text: '1');

    showDialog(
      context: context,
      builder: (ctx) {
        return StatefulBuilder(
          builder: (ctx, update) {
            final results = foods
                .where(
                  (f) => f.name.toLowerCase().contains(search.toLowerCase()),
                )
                .toList();

            return AlertDialog(
              title: const Text('Add Food'),

              content: SizedBox(
                width: 350,
                child: SingleChildScrollView(
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      TextField(
                        decoration: const InputDecoration(
                          labelText: 'Search food',
                          prefixIcon: Icon(Icons.search),
                        ),
                        onChanged: (v) {
                          update(() => search = v);
                        },
                      ),

                      const SizedBox(height: 10),

                      DropdownButtonFormField<Food>(
                        value: selected,
                        isExpanded: true,
                        decoration: const InputDecoration(
                          labelText: 'Food item',
                        ),
                        items: results.map((f) {
                          return DropdownMenuItem(
                            value: f,
                            child: Text(f.name),
                          );
                        }).toList(),
                        onChanged: (v) {
                          if (v != null) {
                            update(() => selected = v);
                          }
                        },
                      ),

                      const SizedBox(height: 12),

                      DropdownButtonFormField<String>(
                        value: type,
                        decoration: const InputDecoration(labelText: 'Meal'),
                        items: ['Breakfast', 'Lunch', 'Snacks', 'Dinner'].map((
                          v,
                        ) {
                          return DropdownMenuItem(value: v, child: Text(v));
                        }).toList(),
                        onChanged: (v) {
                          if (v != null) {
                            update(() => type = v);
                          }
                        },
                      ),

                      TextField(
                        controller: quantity,
                        keyboardType: const TextInputType.numberWithOptions(
                          decimal: true,
                        ),
                        decoration: const InputDecoration(
                          labelText: 'Quantity (servings)',
                        ),
                      ),

                      const SizedBox(height: 15),

                      Text(
                        'Calories: ${selected.calories} kcal per serving',
                        style: const TextStyle(
                          color: green,
                          fontWeight: FontWeight.bold,
                        ),
                      ),

                      Text(
                        'Protein: ${selected.protein}g • '
                        'Carbs: ${selected.carbs}g • '
                        'Fat: ${selected.fat}g',
                        style: const TextStyle(fontSize: 11),
                      ),
                    ],
                  ),
                ),
              ),

              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(ctx),
                  child: const Text('Cancel'),
                ),

                ElevatedButton(
                  style: ElevatedButton.styleFrom(
                    backgroundColor: green,
                    foregroundColor: Colors.white,
                  ),
                  onPressed: () {
                    final q = double.tryParse(quantity.text);

                    if (q == null || q <= 0 || q > 100) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('Enter valid quantity')),
                      );
                      return;
                    }

                    setState(() {
                      meals.add(Meal(selected, type, q, selectedDate));
                    });

                    Navigator.pop(ctx);

                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(content: Text('${selected.name} added!')),
                    );
                  },
                  child: const Text('Save Food'),
                ),
              ],
            );
          },
        );
      },
    );
  }
