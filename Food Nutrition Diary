// FOOD MODEL
class Food {
  final String name;
  final String category;
  final int calories;
  final double protein, carbs, fat;

  const Food(
    this.name,
    this.category,
    this.calories,
    this.protein,
    this.carbs,
    this.fat,
  );
}

// MEAL MODEL
class Meal {
  Food food;
  String type;
  double quantity;
  DateTime date;

  Meal(this.food, this.type, this.quantity, this.date);

  int get calories => (food.calories * quantity).round();
  double get protein => food.protein * quantity;
  double get carbs => food.carbs * quantity;
  double get fat => food.fat * quantity;
}

